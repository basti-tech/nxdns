[nxdns]
# The interface to listen on (default: 127.0.0.1)
# Use :: or "" for all interfaces with DualStack (IPv4+IPv6) support
host = 127.0.0.1

# The port to listen on
port = 53

# Listen to UDP connections
udp = true

# Listen to TCP connections
tcp = true

# Maximum log file size in Megabytes (MB)
max_log_size = 5

# Maximum number of threads for processing requests
workers = 100

# Path to the log file
log_file = dns_log.txt

# TLS/SSL Certificates (Required for DoT, DoH, and DoQ)
# cert = cert.pem
# key = key.pem

# TLS Support (DoT)
# tls = false
# tls_port = 853

# HTTPS Support (DoH)
# doh = false
# doh_port = 443

# QUIC Support (DoQ)
# doq = false
# doq_port = 853
